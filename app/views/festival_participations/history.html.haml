.bg-slate-50.min-h-screen.pb-20
  -# ヘッダー
  %header.bg-indigo-900.text-white.p-6.pt-12.rounded-b-3xl.shadow-lg
    %h1.text-xl.font-bold.mb-1 過去に参加した祭り
    %p.text-indigo-200.text-sm 過去に参加した祭り一覧です

  -# メインコンテンツ
  .p-6
    - if @past_participations.any?
      .space-y-4
        - @past_participations.each do |participation|
          = link_to festival_path(participation.festival), class: 'block bg-white border border-indigo-100 rounded-2xl shadow-sm hover:shadow-md transition-all' do
            .p-6
              - if participation.festival.image.attached?
                .mb-4.rounded-xl.overflow-hidden.h-48
                  = image_tag participation.festival.image, alt: participation.festival.name, class: 'w-full h-full object-cover object-center'

              .flex.justify-between.items-start.mb-3
                .flex-grow
                  .flex.items-center.gap-2.mb-1
                    %i.fa-solid.fa-location-dot.text-gray-400.text-xs
                    %span.text-xs.text-gray-500= [participation.festival.prefecture, participation.festival.city].join(' ')
                  %h3.font-bold.text-lg.text-gray-800.leading-tight.group-hover:text-indigo-600.transition-colors= participation.festival.name

                .flex.flex-col.items-end.gap-2.ml-4
                  %span.bg-green-500.text-white.text-xs.font-bold.px-2.py-1.rounded 参加済み

              .mt-4.grid.grid-cols-2.gap-4.text-sm.text-gray-600
                .flex.items-center.gap-2
                  %i.fa-regular.fa-calendar.text-indigo-400
                  %span.font-mono= participation.festival.start_at.strftime('%m/%d')
                  %span.text-xs (#{I18n.l(participation.festival.start_at, format: '%a')})
                  %span.text-xs.ml-1= participation.festival.start_at.strftime('%H:%M')

                .flex.items-center.gap-2
                  %i.fa-solid.fa-users.text-gray-400
                  %span 募集: #{participation.festival.capacity}人

              .mt-4.text-right
                %span.text-indigo-600.text-sm.font-bold.flex.items-center.justify-end.gap-1
                  詳細を見る
                  %i.fa-solid.fa-chevron-right.text-xs

    - else
      -# Empty State
      .bg-white.border-2.border-dashed.border-indigo-200.rounded-2xl.p-8.text-center.flex.flex-col.items-center.justify-center.gap-4.shadow-sm
        .w-16.h-16.bg-indigo-50.rounded-full.flex.items-center.justify-center.text-indigo-500
          %i.fa-solid.fa-ticket.text-3xl
        %div
          %h3.font-bold.text-lg.text-gray-800 まだ過去に参加した祭りはありません
          %p.text-sm.text-gray-500.mt-1
            祭りを探して参加申込をしてみましょう
        = link_to festivals_path, class: 'bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg shadow-indigo-200 transform transition active:scale-95' do
          祭りを探す


