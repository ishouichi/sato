.bg-slate-50.min-h-screen.pb-10
  -# ヘッダー
  %header.bg-indigo-900.text-white.p-6.pt-12.rounded-b-3xl.shadow-lg
    %h1.text-xl.font-bold.mb-1 こんにちは、#{current_organizer.name}
    %p.text-indigo-200.text-sm= @organization.name

    .mt-6.grid.grid-cols-2.gap-4
      .bg-white.bg-opacity-10.backdrop-blur-sm.p-4.rounded-xl.border.border-white.border-opacity-20
        .text-2xl.font-bold.mb-1
          0
          %span.text-xs.font-normal.opacity-70 人
        .text-xs.text-indigo-200 これまでの参加者
      .bg-white.bg-opacity-10.backdrop-blur-sm.p-4.rounded-xl.border.border-white.border-opacity-20
        .text-2xl.font-bold.mb-1 ¥0
        .text-xs.text-indigo-200 受取可能金額

  -# メインコンテンツ
  .p-6
    %h2.font-bold.text-gray-700.mb-4.flex.items-center.gap-2
      %i.fa-solid.fa-calendar-days.text-indigo-600.text-xl
      現在の募集状況

    - if @festivals.any?
      .space-y-4
        - @festivals.each do |festival|
          .bg-white.border.border-indigo-100.rounded-2xl.shadow-sm.hover:shadow-md.transition-all
            .p-6
              .flex.justify-between.items-start.mb-3
                = link_to edit_organizers_festival_path(festival), class: "flex-grow group" do
                  .flex.items-center.gap-2.mb-1
                    %i.fa-solid.fa-location-dot.text-gray-400.text-xs
                    %span.text-xs.text-gray-500= [festival.prefecture, festival.city].join(' ')
                  %h3.font-bold.text-lg.text-gray-800.leading-tight.group-hover:text-indigo-600.transition-colors= festival.name

                .flex.flex-col.items-end.gap-3.ml-4
                  - if festival.published?
                    %span.bg-green-100.text-green-800.text-xs.font-bold.px-2.py-1.rounded 募集中
                  - else
                    %span.bg-gray-100.text-gray-600.text-xs.font-bold.px-2.py-1.rounded 下書き

                  = button_to organizers_festival_path(festival), method: :delete, form: { data: { turbo_confirm: "#{festival.name}を削除してもよろしいですか？" } }, class: "text-gray-400 hover:text-red-500 transition-colors text-xs flex items-center gap-1" do
                    %i.fa-solid.fa-trash
                    削除

              .mt-2
                .flex.items-center.gap-4.text-sm.text-gray-600
                  = link_to edit_organizers_festival_path(festival), class: "flex items-center gap-1 bg-gray-50 px-2 py-1 rounded hover:text-indigo-600 transition-colors" do
                    %i.fa-regular.fa-calendar.text-indigo-400
                    %span.font-mono= festival.start_at.strftime('%m/%d')
                    %span.text-xs (#{I18n.l(festival.start_at, format: '%a')})

                  = link_to organizers_festival_participants_path(festival), class: "flex items-center gap-1 ml-auto text-gray-600 hover:text-indigo-600 transition-colors" do
                    %i.fa-solid.fa-users.text-gray-400
                    %span 募集中: #{festival.capacity}人

      -# 追加登録ボタン（リストがある場合）
      .mt-6
        = link_to new_organizers_festival_path, class: "w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-600 font-bold py-4 px-6 rounded-xl border border-indigo-200 shadow-sm transform transition active:scale-95 flex items-center justify-center gap-2" do
          %i.fa-solid.fa-plus
          新しい祭りを追加する

    - else
      -# Empty State / CTA
      .bg-white.border-2.border-dashed.border-indigo-200.rounded-2xl.p-8.text-center.flex.flex-col.items-center.justify-center.gap-4.shadow-sm
        .w-16.h-16.bg-indigo-50.rounded-full.flex.items-center.justify-center.text-indigo-500
          %i.fa-solid.fa-users.text-3xl
        %div
          %h3.font-bold.text-lg.text-gray-800 新しい担ぎ手を募集する
          %p.text-sm.text-gray-500.mt-1
            今年の祭りの詳細が決まったら
            %br
            ここから登録してください
        = link_to new_organizers_festival_path, class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 px-6 rounded-xl shadow-lg shadow-indigo-200 transform transition active:scale-95 flex items-center justify-center gap-2" do
          %i.fa-solid.fa-plus
          募集ページを作る

    -# ヒントセクション
    .mt-8.bg-orange-50.p-4.rounded-xl.border.border-orange-100.flex.gap-3.items-start
      %i.fa-solid.fa-circle-info.text-orange-500.text-lg.mt-0.5
      .text-xs.text-orange-800.leading-relaxed
        %span.font-bold ヒント:
        参加者は「半纏（はんてん）の貸出」がある祭りに集まりやすい傾向があります。
