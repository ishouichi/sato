.container.mx-auto.px-4.py-8
  .max-w-md.mx-auto
    .bg-white.shadow-lg.rounded-lg.p-8
      %h2.text-3xl.font-bold.text-gray-800.mb-6.text-center 担ぎ手として登録
      %p.text-gray-600.text-sm.mb-6.text-center 祭りに参加するためのアカウントを作成します
      = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f|
        = render "devise/shared/error_messages", resource: resource
        .field
          = f.label :email, class: "block text-gray-700 text-sm font-bold mb-2"
          = f.email_field :email, autofocus: true, autocomplete: "email", class: "shadow appearance-none border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        .field
          = f.label :password, class: "block text-gray-700 text-sm font-bold mb-2"
          - if @minimum_password_length
            %p.text-xs.text-gray-500.mb-1
              = t("devise.registrations.new.minimum_password_length", count: @minimum_password_length, default: "(#{@minimum_password_length} characters minimum)")
          = f.password_field :password, autocomplete: "new-password", class: "shadow appearance-none border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        .field
          = f.label :password_confirmation, class: "block text-gray-700 text-sm font-bold mb-2"
          = f.password_field :password_confirmation, autocomplete: "new-password", class: "shadow appearance-none border border-gray-300 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        .actions
          = f.submit "アカウントを作成する", class: "w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-200"
      .mt-6.text-center
        = render "devise/shared/links"
