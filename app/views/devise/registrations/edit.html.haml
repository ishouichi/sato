.container.mx-auto.px-4.py-8
  .max-w-md.mx-auto
    %h2.text-2xl.font-bold.text-gray-900.mb-8.text-center アカウント情報の編集
    - if Organizer.exists?(email: resource.email)
      .mb-6
        = button_to t('home.index.switch_to_organizer'), switch_to_organizer_from_user_path, method: :post, class: "w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-xl shadow-lg transition duration-200"
    = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f|
      = render "devise/shared/error_messages", resource: resource

      .space-y-5
        %div
          = f.label :real_name, "本名", class: "block text-sm font-bold text-gray-700 mb-1"
          = f.text_field :real_name, class: "w-full text-lg bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition-all"
          %p.text-xs.text-gray-500.mt-1 本名は祭りの参加者側に表示するときだけ使われます。

        %div
          = f.label :nickname, "ニックネーム", class: "block text-sm font-bold text-gray-700 mb-1"
          = f.text_field :nickname, class: "w-full text-lg bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition-all"
          %p.text-xs.text-gray-500.mt-1 アプリ内で表示される名前として使われます。

        %div
          = f.label :email, class: "block text-sm font-bold text-gray-700 mb-1"
          = f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full text-lg bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition-all"

        - if devise_mapping.confirmable? && resource.pending_reconfirmation?
          .bg-yellow-50.border.border-yellow-200.text-yellow-800.px-4.py-3.rounded-xl.mb-4.text-sm
            Currently waiting confirmation for: #{resource.unconfirmed_email}

        %div
          = f.label :password, class: "block text-sm font-bold text-gray-700 mb-1"
          %span.text-xs.text-gray-500 (変更しない場合は空欄のままにしてください)
          = f.password_field :password, autocomplete: "new-password", class: "w-full text-lg bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition-all mt-1"
          - if @minimum_password_length
            %p.text-xs.text-gray-500.mt-1
              #{@minimum_password_length}文字以上で入力してください

        %div
          = f.label :password_confirmation, class: "block text-sm font-bold text-gray-700 mb-1"
          = f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full text-lg bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition-all"

        %div
          = f.label :current_password, class: "block text-sm font-bold text-gray-700 mb-1"
          %span.text-xs.text-gray-500 (変更を確認するために現在のパスワードが必要です)
          = f.password_field :current_password, autocomplete: "current-password", class: "w-full text-lg bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition-all mt-1"

        .pt-4
          = f.submit "更新する", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded-xl shadow-lg transition duration-200"

    .mt-10.border-t.border-gray-100.pt-8
      %h3.text-lg.font-bold.text-gray-900.mb-4 アカウントの削除
      .bg-red-50.border.border-red-100.rounded-xl.p-4
        %p.text-sm.text-red-800.mb-4 アカウントを削除すると元に戻すことはできません。
        = button_to "アカウントを削除する", registration_path(resource_name), data: { confirm: "本当に削除しますか？", turbo_confirm: "本当に削除しますか？" }, method: :delete, class: "w-full bg-white border border-red-200 text-red-600 hover:bg-red-50 font-bold py-2 px-4 rounded-xl transition duration-200 text-sm"

    .mt-6.text-center
      = link_to "戻る", root_path, class: "text-gray-500 hover:text-gray-700 text-sm font-bold"
