.bg-slate-50.min-h-screen.pb-10
  -# ヘッダー
  %header.bg-indigo-900.text-white.p-6.pt-12.rounded-b-3xl.shadow-lg
    %h1.text-xl.font-bold.mb-1 参加できる祭りを探す
    %p.text-indigo-200.text-sm 開催予定の祭りから選んで参加申込ができます

  -# 検索フォーム
  .p-6.bg-white.border-b.border-gray-100
    = form_with url: festivals_path, method: :get, local: true, class: "space-y-4" do
      .grid.grid-cols-1.md:grid-cols-2.gap-4
        .flex.flex-col
          = label_tag :prefecture, "都道府県", class: "text-sm font-bold text-gray-700 mb-1"
          = select_tag :prefecture, options_for_select(@prefectures.map { |p| [p, p] }, @selected_prefecture), { include_blank: "すべて", class: "border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" }

        .flex.flex-col
          = label_tag :start_date, "開催日", class: "text-sm font-bold text-gray-700 mb-1"
          = date_field_tag :start_date, @selected_start_date, class: "border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"

      = submit_tag "この条件で探す", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg shadow-indigo-200 transform transition active:scale-95"

  -# メインコンテンツ
  .p-6
    - if @festivals.any?
      .space-y-4
        - @festivals.each do |festival|
          = link_to festival_path(festival), class: "block bg-white border border-indigo-100 rounded-2xl shadow-sm hover:shadow-md transition-all" do
            .p-6
              - if festival.image.attached?
                .mb-4.rounded-xl.overflow-hidden.h-48
                  = image_tag festival.image, alt: festival.name, class: "w-full h-full object-cover object-center"

              .flex.justify-between.items-start.mb-3
                .flex-grow
                  .flex.items-center.gap-2.mb-1
                    %i.fa-solid.fa-location-dot.text-gray-400.text-xs
                    %span.text-xs.text-gray-500= [festival.prefecture, festival.city].join(' ')
                  %h3.font-bold.text-lg.text-gray-800.leading-tight.group-hover:text-indigo-600.transition-colors= festival.name

                .flex.flex-col.items-end.gap-2.ml-4
                  %span.bg-red-500.text-white.text-xs.font-bold.px-2.py-1.rounded 募集中

              .mt-4.grid.grid-cols-2.gap-4.text-sm.text-gray-600
                .flex.items-center.gap-2
                  %i.fa-regular.fa-calendar.text-indigo-400
                  %span.font-mono= festival.start_at.strftime('%m/%d')
                  %span.text-xs (#{I18n.l(festival.start_at, format: '%a')})
                  %span.text-xs.ml-1= festival.start_at.strftime('%H:%M')

                .flex.items-center.gap-2
                  %i.fa-solid.fa-users.text-gray-400
                  %span 募集: #{festival.capacity}人

              .mt-4.text-right
                %span.text-indigo-600.text-sm.font-bold.flex.items-center.justify-end.gap-1
                  詳細を見る
                  %i.fa-solid.fa-chevron-right.text-xs

    - else
      -# Empty State
      .bg-white.border-2.border-dashed.border-indigo-200.rounded-2xl.p-8.text-center.flex.flex-col.items-center.justify-center.gap-4.shadow-sm
        .w-16.h-16.bg-indigo-50.rounded-full.flex.items-center.justify-center.text-indigo-500
          %i.fa-solid.fa-calendar-days.text-3xl
        %div
          %h3.font-bold.text-lg.text-gray-800 現在参加募集している祭りはありません
          %p.text-sm.text-gray-500.mt-1
            条件を変更して再度検索してください


